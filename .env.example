# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- AI providers ---
# Embeddings still go through real OpenAI (text-embedding-3-small).
OPENAI_API_KEY=sk-...
# LLM (chat generation) goes through OpenRouter by default (see core/config.py's
# llm_base_url) — OpenAI-compatible API, free-tier models available, no billing
# needed. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Database (local, non-docker dev) ---
# When running via `docker compose`, this is overridden to point at the postgres service.
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

# --- Background jobs (local, non-docker dev) ---
# When running via `docker compose`, this is overridden to point at the redis service.
REDIS_URL=redis://localhost:6379

# --- App ---
ENVIRONMENT=development

# --- Auth ---
# Has an insecure dev default in app/core/config.py — override for any real deployment.
# JWT_SECRET_KEY=generate-a-long-random-value-for-production
